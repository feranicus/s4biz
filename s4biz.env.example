# Runtime secrets for the CONTAINER. Copy to s4biz.env on the DROPLET only (chmod 600).
# docker-compose.web.yml loads it if present, and works without it.
#
# Contact enquiries are always written to disk first, so an absent mail gateway loses nothing.
# These only decide whether an enquiry also reaches an inbox and a phone.

# Gmail API delivery. SMTP is blocked outbound on this droplet, so do not switch to smtplib.
GMAIL_SENDER=
GMAIL_SA_B64=

# Telegram as a second channel.
BOT_TOKEN=
ALERT_TG_CHAT=

# Where enquiries go. A comma separated list.
ALERT_EMAIL=feranicus@s4biz.io
